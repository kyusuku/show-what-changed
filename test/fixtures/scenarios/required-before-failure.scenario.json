{
  "schemaVersion": 2,
  "id": "required-before-failure",
  "title": "Required BEFORE control is missing",
  "steps": [
    {
      "id": "open",
      "op": "goto",
      "path": "/pricing"
    },
    {
      "id": "ready",
      "op": "expectVisible",
      "target": {
        "role": "heading",
        "name": "Pricing"
      }
    },
    {
      "id": "required-toggle",
      "op": "click",
      "target": {
        "role": "switch",
        "name": "Yearly"
      },
      "timeoutMs": 2000
    },
    {
      "id": "saving",
      "op": "expectVisible",
      "target": {
        "text": "Save 20%"
      },
      "only": "after"
    },
    {
      "id": "hover",
      "op": "hover",
      "target": {
        "role": "button",
        "name": "Get Pro"
      }
    },
    {
      "id": "poster",
      "op": "screenshot",
      "note": "BEFORE must remain visibly incomplete"
    }
  ]
}
