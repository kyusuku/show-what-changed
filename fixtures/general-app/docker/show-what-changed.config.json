{
  "schemaVersion": 2,
  "execution": {
    "env": {
      "PORT": { "template": "{port}" },
      "APP_ORIGIN": { "template": "{origin}" },
      "DATA": { "template": "{stateDir}" },
      "DB_HOST": { "template": "{service.db.host}" },
      "DB_PORT": { "template": "{service.db.port}" },
      "LOG_VALUE": { "fromEnv": "SWC_FIXTURE_LOG_CANARY" }
    },
    "services": [
      {
        "id": "db",
        "kind": "container",
        "image": "postgres@sha256:979c4379dd698aba0b890599a6104e082035f98ef31d9b9291ec22f2b13059ca",
        "containerPort": 5432,
        "env": {
          "POSTGRES_PASSWORD": { "fromEnv": "SWC_FIXTURE_DB_PASSWORD" },
          "POSTGRES_USER": { "literal": "synthetic" },
          "POSTGRES_DB": { "literal": "synthetic" }
        },
        "ready": { "kind": "tcp", "timeoutMs": 30000 }
      }
    ],
    "requires": [{ "argv": ["node", "--version"], "expectedVersion": "24.x" }],
    "setup": [{ "argv": ["node", "setup.mjs"] }],
    "start": { "kind": "container", "build": { "context": ".", "dockerfile": "Dockerfile" }, "containerPort": 8080 },
    "ready": { "path": "/ready", "timeoutMs": 30000 },
    "bootstrap": [{ "argv": ["node", "bootstrap.mjs"] }],
    "state": { "kind": "stateless" }
  },
  "routes": { "include": ["/"] }
}
