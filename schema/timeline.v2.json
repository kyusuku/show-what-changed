{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 2
    },
    "runId": {
      "type": "string",
      "pattern": "^\\d{8}T\\d{9}Z-[a-f0-9]{16}$"
    },
    "captureMode": {
      "type": "string",
      "enum": [
        "motion",
        "keyframes"
      ]
    },
    "fps": {
      "type": "number",
      "const": 30
    },
    "templateVersion": {
      "type": "number",
      "const": 2
    },
    "width": {
      "type": "number",
      "const": 1920
    },
    "height": {
      "type": "number",
      "const": 686
    },
    "captureSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "stepBoundaries": {
      "maxItems": 36,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "scenarioId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "stepId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "startFrame": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "endFrame": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "scenarioId",
          "stepId",
          "startFrame",
          "endFrame"
        ],
        "additionalProperties": false
      }
    },
    "annotations": {
      "maxItems": 432,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "scenarioId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "stepId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "side": {
            "type": "string",
            "enum": [
              "before",
              "after"
            ]
          },
          "kind": {
            "type": "string",
            "enum": [
              "waiting",
              "expected_absent",
              "skipped_by_side",
              "failed",
              "blocked"
            ]
          },
          "startFrame": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "endFrame": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "scenarioId",
          "stepId",
          "side",
          "kind",
          "startFrame",
          "endFrame"
        ],
        "additionalProperties": false
      }
    },
    "posterSelection": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "checkpoint"
            },
            "scenarioId": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
            },
            "stepId": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
            },
            "changeRatio": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "kind",
            "scenarioId",
            "stepId",
            "changeRatio"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "incomplete"
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f]*$"
            }
          },
          "required": [
            "kind",
            "reason"
          ],
          "additionalProperties": false
        }
      ]
    },
    "viewport": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 320,
          "maximum": 1920
        },
        "height": {
          "type": "integer",
          "minimum": 240,
          "maximum": 1200
        },
        "deviceScaleFactor": {
          "type": "number",
          "const": 1
        }
      },
      "required": [
        "width",
        "height",
        "deviceScaleFactor"
      ],
      "additionalProperties": false
    },
    "totalFrames": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 5490
    },
    "segments": {
      "minItems": 1,
      "maxItems": 39,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "scenarioId": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
              },
              "startFrame": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "image": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "^(?!\\/|[A-Za-z]:)(?!.*(?:^|\\/)\\.{1,2}(?:\\/|$))(?!.*\\/\\/)(?!.*\\/$)[^\\\\\\x00-\\x1f\\x7f]+$"
              },
              "kind": {
                "type": "string",
                "const": "title"
              },
              "stepId": {
                "type": "null"
              },
              "durationFrames": {
                "type": "number",
                "const": 30
              }
            },
            "required": [
              "scenarioId",
              "startFrame",
              "image",
              "kind",
              "stepId",
              "durationFrames"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "scenarioId": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
              },
              "startFrame": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "image": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "^(?!\\/|[A-Za-z]:)(?!.*(?:^|\\/)\\.{1,2}(?:\\/|$))(?!.*\\/\\/)(?!.*\\/$)[^\\\\\\x00-\\x1f\\x7f]+$"
              },
              "kind": {
                "type": "string",
                "const": "step"
              },
              "stepId": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
              },
              "durationFrames": {
                "type": "integer",
                "minimum": 6,
                "maximum": 90
              }
            },
            "required": [
              "scenarioId",
              "startFrame",
              "image",
              "kind",
              "stepId",
              "durationFrames"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "scenarioId": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
              },
              "startFrame": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "kind": {
                "type": "string",
                "const": "motion"
              },
              "stepId": {
                "type": "null"
              },
              "durationFrames": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1800
              },
              "sourceStartMs": {
                "type": "number",
                "minimum": 0
              },
              "sourceEndMs": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "scenarioId",
              "startFrame",
              "kind",
              "stepId",
              "durationFrames",
              "sourceStartMs",
              "sourceEndMs"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "poster": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!\\/|[A-Za-z]:)(?!.*(?:^|\\/)\\.{1,2}(?:\\/|$))(?!.*\\/\\/)(?!.*\\/$)[^\\\\\\x00-\\x1f\\x7f]+$"
    },
    "images": {
      "minItems": 1,
      "maxItems": 13000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^(?!\\/|[A-Za-z]:)(?!.*(?:^|\\/)\\.{1,2}(?:\\/|$))(?!.*\\/\\/)(?!.*\\/$)[^\\\\\\x00-\\x1f\\x7f]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "path",
          "sha256",
          "bytes"
        ],
        "additionalProperties": false
      }
    },
    "selections": {
      "maxItems": 5400,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "frame": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "before": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "^(?!\\/|[A-Za-z]:)(?!.*(?:^|\\/)\\.{1,2}(?:\\/|$))(?!.*\\/\\/)(?!.*\\/$)[^\\\\\\x00-\\x1f\\x7f]+$"
              },
              {
                "type": "null"
              }
            ]
          },
          "after": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "^(?!\\/|[A-Za-z]:)(?!.*(?:^|\\/)\\.{1,2}(?:\\/|$))(?!.*\\/\\/)(?!.*\\/$)[^\\\\\\x00-\\x1f\\x7f]+$"
              },
              {
                "type": "null"
              }
            ]
          },
          "overlay": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^(?!\\/|[A-Za-z]:)(?!.*(?:^|\\/)\\.{1,2}(?:\\/|$))(?!.*\\/\\/)(?!.*\\/$)[^\\\\\\x00-\\x1f\\x7f]+$"
          }
        },
        "required": [
          "frame",
          "before",
          "after",
          "overlay"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "runId",
    "captureMode",
    "fps",
    "templateVersion",
    "width",
    "height",
    "captureSha256",
    "stepBoundaries",
    "annotations",
    "posterSelection",
    "viewport",
    "totalFrames",
    "segments",
    "poster",
    "images",
    "selections"
  ],
  "additionalProperties": false
}
